# Override these paths with -D when using another SDK installation.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(RK3506_HOST "/home/kinho/Lyra-sdk/buildroot/output/rockchip_rk3506_luckfox/host" CACHE PATH "Buildroot host directory")
set(RK3506_QT "/opt/qt5.15.19-arm" CACHE PATH "Target Qt installation")
set(CMAKE_C_COMPILER "${RK3506_HOST}/bin/arm-buildroot-linux-gnueabihf-gcc")
set(CMAKE_CXX_COMPILER "${RK3506_HOST}/bin/arm-buildroot-linux-gnueabihf-g++")
set(CMAKE_SYSROOT "${RK3506_HOST}/arm-buildroot-linux-gnueabihf/sysroot")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}" "${RK3506_QT}")
set(CMAKE_PREFIX_PATH "${RK3506_QT}" CACHE STRING "Qt prefix")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard")
